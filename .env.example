# NODE ENV
NODE_ENV=dev
# PUBLIC PORT FOR APPLICATION
PUBLIC_PORT=3000

# POSTGRES DATABASE CONFIG
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret
DATABASE_NAME=cd-bi
DATABASE_PUBLIC_PORT=5432

#SWAGGER
ENABLE_SWAGGER=true
SWAGGER_TITLE='Code driven BI'
SWAGGER_DESCRIPTION='The cd bi API description'

#LOGGER
LOG_LEVEL='error'

#AUTHENTIFICATION
AUTH_METHOD=jwt
SESSION_ID_METHOD=cookie
JWT_SECRET=your-secure-secret-key-32-chars-minimum
JWT_EXPIRES_IN=3600
SESSION_EXPIRES_IN=86400
SESSION_PROVIDER=redis
REDIS_URL=redis://redis:6379